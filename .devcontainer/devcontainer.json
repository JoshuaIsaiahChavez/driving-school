{
  "name": "AI Driving School",
  "build": {"dockerfile": "Dockerfile"},
  "remoteUser": "vscode",
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "AI Driving School", "onAutoForward": "openBrowser"}},
  "customizations": {"vscode": {
    "extensions": ["ms-python.python"],
    "settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"}
  }}
}
